# Never commit live credentials. The previously exposed pilot key was rotated;
# configure only current credentials in the ignored local .env.
#
# All of these are shared by kol_database/ (the Mango Growth & BD
# Intelligence Cockpit) -- see kol_database/README.md, especially §11.6.
RAPID_X_API_KEY=
RAPID_X_HOST=twitter241.p.rapidapi.com
SURF_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
YOUTUBE_API_KEY=
SCRAPECREATORS_API_KEY=
APIFY_TOKEN=

# Internal write boundary. Leave blank for public-read-only / fail-closed local
# development; state-changing requests stay disabled until a long random value
# is configured. Set the real value only in the hosting platform or ignored
# local .env; see kol_database/docs/railway-internal-release.md.
INTERNAL_ACCESS_TOKEN=
INTERNAL_ACCESS_COOKIE_MAX_AGE=43200

# Business-day boundary for Home due-date ordering on UTC hosting.
MANGO_BUSINESS_TIMEZONE=Asia/Shanghai
